#!/bin/bash
# First-boot bootstrap. Terraform fills the unescaped template values.
# Bash variables in the generated stop script are escaped with a doubled dollar.
set -euo pipefail
exec > >(tee -a /var/log/ai-image-studio-user-data.log) 2>&1
echo "ai-image-studio user-data $(date -Is)"

install -d /usr/local/sbin /var/lib/ai-image-studio /etc/systemd/system

cat >/etc/ai-image-studio.env <<'EOF'
BUCKET=${bucket}
AWS_REGION=${region}
AWS_DEFAULT_REGION=${region}
DATA_VOLUME_ID=${data_volume_id}
IDLE_MINUTES=${idle_minutes}
COMFY_PORT=8188
EOF
chmod 644 /etc/ai-image-studio.env

cat >/usr/local/sbin/ai-image-studio-stop <<'EOF'
#!/bin/bash
set -euo pipefail
set -a
# shellcheck disable=SC1091
source /etc/ai-image-studio.env
set +a
TOKEN=$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
INSTANCE_ID=$(curl -fsS -H "X-aws-ec2-metadata-token: $${TOKEN}" http://169.254.169.254/latest/meta-data/instance-id)
for log_file in /var/log/ai-image-studio-user-data.log /var/log/ai-image-studio-setup.log /var/log/ai-image-studio-idle.log /var/log/comfyui.log; do
  if [[ -f "$${log_file}" ]]; then
    base=$(basename "$${log_file}")
    aws s3 cp "$${log_file}" "s3://$${BUCKET}/logs/$${INSTANCE_ID}-$${base}" || true
  fi
done
aws ec2 stop-instances --region "$${AWS_REGION}" --instance-ids "$${INSTANCE_ID}"
EOF
chmod 755 /usr/local/sbin/ai-image-studio-stop

cat >/etc/systemd/system/ai-image-studio-failsafe.service <<'EOF'
[Unit]
Description=Stop the GPU instance if first-boot setup hangs
ConditionPathExists=!/var/lib/ai-image-studio/setup-complete

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ai-image-studio-stop
EOF

cat >/etc/systemd/system/ai-image-studio-failsafe.timer <<'EOF'
[Unit]
Description=Failsafe timer for ai-image-studio first boot

[Timer]
OnBootSec=${failsafe_minutes}min
AccuracySec=30s
Persistent=false
Unit=ai-image-studio-failsafe.service

[Install]
WantedBy=timers.target
EOF

cat >/etc/systemd/system/ai-image-studio-setup.service <<'EOF'
[Unit]
Description=Install ComfyUI and model weights
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/ai-image-studio/setup-complete

[Service]
Type=oneshot
EnvironmentFile=/etc/ai-image-studio.env
ExecStart=/bin/bash -c 'aws s3 cp s3://${bucket}/bootstrap/setup.sh /tmp/ai-image-studio-setup.sh && bash /tmp/ai-image-studio-setup.sh'
TimeoutStartSec=infinity
EOF

on_err() {
  echo "user-data failed" >&2
  if [[ -x /usr/local/sbin/ai-image-studio-stop ]]; then
    /usr/local/sbin/ai-image-studio-stop || true
  fi
  exit 1
}
trap on_err ERR

if ! command -v aws >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y awscli curl ca-certificates
fi

systemctl daemon-reload
systemctl enable --now ai-image-studio-failsafe.timer
systemctl enable ai-image-studio-setup.service
systemctl start ai-image-studio-setup.service
echo "user-data finished $(date -Is)"
